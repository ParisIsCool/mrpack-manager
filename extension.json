{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "mrpack-manager",
    "name": "Modrinth",
    "version": "1.0.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "description": "Inspect Modrinth modpacks and prepare Minecraft server deployments.",
    "provider": "MrpackManager\\MrpackManagerProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mm",
        "screens": [
            {
                "id": "main",
                "area": "server",
                "path": "mrpack-manager",
                "nav": {
                    "label": "Modrinth"
                }
            }
        ]
    }
}
